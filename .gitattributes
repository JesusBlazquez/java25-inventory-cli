# Normalise line endings in the repository; check out native endings on each OS
* text=auto

# Scripts that must keep their line endings regardless of OS
mvnw        text eol=lf
*.sh        text eol=lf
*.cmd       text eol=crlf
*.bat       text eol=crlf
*.ps1       text eol=crlf

# Binaries
*.jar       binary
*.png       binary
*.jpg       binary
